---
import GameCard from '../components/GameCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from "astro:content";
import { PORTFOLIO_URL } from '../Constants';

const entries = (await getCollection("games")).sort((a, b) => a.data.order - b.data.order);

/* Plain objects for the cards and for scripts/portal.js. */
const games = entries.map((entry) => ({
	slug: entry.slug,
	...entry.data,
	categories: entry.data.categories.join(', '),
}));

/* "<" is escaped so the data can never close its own script tag. */
const gamesJson = JSON.stringify(games).replace(/</g, '\\u003c');
---

<BaseLayout>
	<main id="home">

		<!-- Opening: who and what, in two lines. -->
		<section id="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">Small games by Rubén Rodríguez</h1>
			<p>Frasquito Games is his personal label. Each of these games started as an experiment, and each one plays right here on the page.</p>
		</section>

		<!-- The play panel. Empty and hidden until a game is chosen; nothing loads before that. -->
		<section id="game-panel" aria-labelledby="panel-title" tabindex="-1" hidden>
			<div class="panel-bar">
				<div class="panel-heading">
					<h2 id="panel-title"></h2>
					<p id="panel-genre"></p>
				</div>
				<button type="button" class="btn-stop" id="panel-stop">
					<svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
					<span id="panel-stop-label">Close</span>
				</button>
			</div>

			<div class="panel-body">
				<div id="game-displayer">
					<img class="player-poster" id="player-poster" alt="" width="1280" height="720" />
					<button type="button" class="player-start" id="player-start">
						<span>
							<svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>
							<span id="player-start-label">Play</span>
						</span>
					</button>
					<div id="game-mount"></div>
					<div id="game-loader" role="status" hidden>
						<svg viewBox="0 0 256 256" aria-hidden="true" fill="none" stroke-width="24" stroke-linecap="round"><line x1="128" y1="32" x2="128" y2="64"/><line x1="195.9" y1="60.1" x2="173.3" y2="82.7" opacity=".9"/><line x1="224" y1="128" x2="192" y2="128" opacity=".8"/><line x1="195.9" y1="195.9" x2="173.3" y2="173.3" opacity=".7"/><line x1="128" y1="224" x2="128" y2="192" opacity=".6"/><line x1="60.1" y1="195.9" x2="82.7" y2="173.3" opacity=".5"/><line x1="32" y1="128" x2="64" y2="128" opacity=".4"/><line x1="60.1" y1="60.1" x2="82.7" y2="82.7" opacity=".3"/></svg>
						<span id="game-loader-label">Loading</span>
					</div>
					<div class="player-note" id="player-note" hidden></div>
				</div>

				<div class="panel-text">
					<p class="panel-title-note" id="panel-title-note" hidden></p>
					<p id="panel-description"></p>
				</div>

				<aside class="panel-facts" aria-label="About this game">
					<dl id="panel-facts"></dl>
					<ul class="panel-links" id="panel-links"></ul>
				</aside>
			</div>
		</section>

		<section id="games" aria-labelledby="games-title">
			<h2 class="games-heading visually-hidden" id="games-title">Games</h2>

			<div id="game-grid">
				{games.map((game, index) => <GameCard game={game} index={index} />)}
			</div>
		</section>

		<section id="about" aria-labelledby="about-title">
			<div class="about-mark">
				<img src="/images/logo.png" alt="" width="72" height="72" />
				<h2 id="about-title">About Frasquito Games</h2>
			</div>
			<div class="about-text">
				<p>Frasquito Games is the personal label of Rubén Rodríguez, a game developer from Spain. It started in 2017, right after he finished his degree in Multimedia Engineering, as the place to try out engines and ideas on his own time.</p>
				<p>Every game here began as an experiment: a new framework to learn, a contest to enter, an idea to finish and ship.</p>
				<p>Today Rubén works professionally on HTML5 games, and this is where his independent projects live.</p>
				<p class="about-link">
					<a class="btn-link" href={PORTFOLIO_URL} target="_blank" rel="noopener">Portfolio and contact at rubirp.dev
						<svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3H3v10h10v-3M9 3h4v4M13 3 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</p>
			</div>
		</section>
	</main>
</BaseLayout>

<script type="application/json" id="games-data" set:html={gamesJson}></script>
<script src="../scripts/portal.js"></script>
