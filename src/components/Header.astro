---
import { PORTFOLIO_URL } from '../Constants';
---

<header class="site-header">
    <div class="header-inner">
        <a id="brand-area" href="#home" aria-label="Frasquito Games, home">
            <img id="brand-logo" src="/images/logo.png" alt="" width="40" height="40" />
            <span id="brand-name"><span>Frasquito</span><span>Games</span></span>
        </a>

        <div id="nav-area">
            <nav aria-label="Main">
                <a class="nav-link" href="#home" data-nav="games">Games</a>
                <a class="nav-link" href="#about" data-nav="about">About</a>
                <a class="nav-link" href={PORTFOLIO_URL} target="_blank" rel="noopener">Portfolio
                    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3H3v10h10v-3M9 3h4v4M13 3 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="visually-hidden">(opens rubirp.dev)</span>
                </a>
            </nav>
        </div>
    </div>
</header>
